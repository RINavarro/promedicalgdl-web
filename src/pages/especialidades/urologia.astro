---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";

const careAreas = [
  {
    title: "Salud urinaria",
    description:
      "Valoración especializada del sistema urinario con atención individual y profesional.",
  },
  {
    title: "Salud prostática",
    description:
      "Atención y seguimiento urológico de acuerdo con las necesidades particulares de cada paciente.",
  },
  {
    title: "Cálculos urinarios",
    description:
      "Valoración médica especializada de padecimientos relacionados con cálculos del sistema urinario.",
  },
  {
    title: "Infecciones urinarias",
    description:
      "Evaluación médica de problemas urinarios que requieren atención y seguimiento profesional.",
  },
  {
    title: "Salud sexual masculina",
    description:
      "Atención confidencial y profesional de aspectos relacionados con la salud sexual masculina.",
  },
  {
    title: "Valoración preventiva",
    description:
      "Revisión urológica individual de acuerdo con edad, antecedentes y necesidades de cada paciente.",
  },
];
---

<MainLayout
  title="Urología | Pro Medical GDL"
  description="Atención especializada en urología, salud urinaria y salud urológica masculina."
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="urology-hero">
      <div class="container hero-grid">

        <div class="hero-content">
          <span class="eyebrow">
            Especialidad médica
          </span>

          <h1>
            Urología
          </h1>

          <p class="hero-lead">
            Atención especializada en el cuidado del sistema urinario
            y la salud urológica, mediante valoración médica individual
            y un enfoque profesional, confidencial y personalizado.
          </p>

          <div class="hero-actions">
            <a class="primary-button" href="/#contacto">
              Agendar valoración
            </a>

            <a class="secondary-button" href="#areas-atencion">
              Conocer áreas de atención
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="visual-symbol">
            <span>U</span>
          </div>

          <div class="visual-copy">
            <strong>Atención urológica especializada</strong>

            <span>
              Valoración individual y acompañamiento profesional.
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- ÁREAS DE ATENCIÓN -->
    <section
      id="areas-atencion"
      class="care-section section"
    >
      <div class="container">

        <div class="section-header">
          <span class="eyebrow">
            Áreas de atención
          </span>

          <h2>
            Atención urológica enfocada en
            <span>cada paciente</span>
          </h2>

          <p>
            La especialidad de urología comprende distintas áreas de la
            salud urinaria y masculina. Cada caso requiere una valoración
            médica individual.
          </p>
        </div>

        <div class="care-grid">
          {
            careAreas.map((area, index) => (
              <article class="care-card">
                <span class="care-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3>{area.title}</h3>

                <p>{area.description}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- QUÉ ES UROLOGÍA -->
    <section class="info-section section">
      <div class="container info-grid">

        <div class="info-heading">
          <span class="eyebrow">
            Atención profesional
          </span>

          <h2>
            ¿Qué atiende la
            <span>urología?</span>
          </h2>
        </div>

        <div class="info-content">
          <p>
            La urología es la especialidad médica encargada de la
            valoración y tratamiento de padecimientos relacionados con
            el sistema urinario y con aspectos del aparato reproductor
            masculino.
          </p>

          <p>
            La atención debe adaptarse a cada paciente, considerando su
            historia clínica, antecedentes y necesidades particulares.
          </p>

          <div class="info-note">
            <span aria-hidden="true">i</span>

            <p>
              La información presentada en este sitio es de carácter
              informativo y no sustituye una valoración médica.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container cta-container">

        <div>
          <span class="cta-eyebrow">
            Atención urológica
          </span>

          <h2>
            Agenda una valoración con nuestro especialista
          </h2>

          <p>
            Recibe orientación médica profesional en un entorno
            confidencial y personalizado.
          </p>
        </div>

        <a class="cta-button" href="/#contacto">
          Agendar valoración
        </a>

      </div>
    </section>
  </main>
</MainLayout>

<style>
  /* Shared */

  .eyebrow {
    display: block;

    margin-bottom: 0.7rem;

    color: var(--color-secondary);

    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Hero */

  .urology-hero {
    overflow: hidden;

    background:
      radial-gradient(
        circle at 82% 18%,
        rgba(18, 167, 160, 0.14),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        #ffffff 0%,
        #f5f9fb 100%
      );
  }

  .hero-grid {
    min-height: 520px;

    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: center;
    gap: 5rem;

    padding-block: 4.5rem;
  }

  .hero-content {
    max-width: 650px;
  }

  .hero-content h1 {
    margin: 0;

    color: var(--color-primary);

    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero-lead {
    max-width: 620px;

    margin: 1.5rem 0 0;

    color: var(--color-text-muted);

    font-size: 1.08rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;

    margin-top: 2rem;
  }

  .primary-button,
  .secondary-button {
    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding-inline: 1.5rem;

    border-radius: var(--radius-sm);

    font-size: 0.92rem;
    font-weight: 650;

    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .primary-button {
    color: white;
    background: var(--color-primary);
  }

  .primary-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .secondary-button {
    color: var(--color-primary);

    border: 1px solid var(--color-border);
    background: white;
  }

  .secondary-button:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  /* Hero visual */

  .hero-visual {
    position: relative;

    min-height: 350px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 2rem;

    border: 1px solid rgba(13, 63, 122, 0.08);
    border-radius: var(--radius-lg);

    background:
      radial-gradient(
        circle at center,
        rgba(18, 167, 160, 0.12),
        transparent 58%
      ),
      rgba(255, 255, 255, 0.78);

    box-shadow: var(--shadow-md);
  }

  .visual-symbol {
    width: 118px;
    height: 118px;

    display: grid;
    place-items: center;

    border: 2px solid var(--color-secondary);
    border-radius: 50%;

    color: var(--color-secondary);

    font-size: 2.8rem;
    font-weight: 700;
  }

  .visual-copy {
    max-width: 300px;

    display: flex;
    flex-direction: column;
    gap: 0.45rem;

    margin-top: 1.5rem;

    text-align: center;
  }

  .visual-copy strong {
    color: var(--color-primary);

    font-size: 1rem;
  }

  .visual-copy span {
    color: var(--color-text-muted);

    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Care */

  .care-section {
    background: white;
  }

  .section-header {
    max-width: 760px;

    margin-bottom: 2.8rem;
  }

  .section-header h2,
  .info-heading h2 {
    margin: 0;

    color: var(--color-primary);

    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.14;
    letter-spacing: -0.03em;
  }

  .section-header h2 span,
  .info-heading h2 span {
    color: var(--color-secondary);
  }

  .section-header > p {
    max-width: 680px;

    margin: 1.15rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.75;
  }

  .care-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .care-card {
    min-height: 230px;

    padding: 1.7rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: white;

    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .care-card:hover {
    transform: translateY(-4px);

    border-color: rgba(18, 167, 160, 0.35);
    box-shadow: var(--shadow-md);
  }

  .care-number {
    display: block;

    margin-bottom: 1.3rem;

    color: var(--color-secondary);

    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .care-card h3 {
    margin: 0;

    color: var(--color-primary);

    font-size: 1.08rem;
  }

  .care-card p {
    margin: 0.8rem 0 0;

    color: var(--color-text-muted);

    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Informative section */

  .info-section {
    background: var(--color-background-soft);
  }

  .info-grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 5rem;
  }

  .info-content {
    max-width: 650px;
  }

  .info-content > p {
    margin: 0 0 1.2rem;

    color: var(--color-text-muted);

    line-height: 1.8;
  }

  .info-note {
    display: flex;
    align-items: flex-start;
    gap: 1rem;

    margin-top: 2rem;
    padding: 1.25rem;

    border: 1px solid rgba(18, 167, 160, 0.25);
    border-radius: var(--radius-md);

    background: rgba(255, 255, 255, 0.75);
  }

  .info-note > span {
    width: 32px;
    height: 32px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: white;
    background: var(--color-secondary);

    font-size: 0.8rem;
    font-weight: 700;
  }

  .info-note p {
    margin: 0;

    color: var(--color-text-muted);

    font-size: 0.84rem;
    line-height: 1.6;
  }

  /* CTA */

  .cta-section {
    padding-block: 4rem;

    background: var(--color-primary);
  }

  .cta-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .cta-container > div {
    max-width: 720px;
  }

  .cta-eyebrow {
    display: block;

    margin-bottom: 0.5rem;

    color: rgba(255, 255, 255, 0.65);

    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cta-container h2 {
    margin: 0;

    color: white;

    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    line-height: 1.2;
  }

  .cta-container p {
    margin: 0.8rem 0 0;

    color: rgba(255, 255, 255, 0.72);

    line-height: 1.7;
  }

  .cta-button {
    flex: 0 0 auto;

    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding-inline: 1.5rem;

    border-radius: var(--radius-sm);

    color: var(--color-primary);
    background: white;

    font-size: 0.9rem;
    font-weight: 700;

    transition: transform var(--transition-fast);
  }

  .cta-button:hover {
    transform: translateY(-2px);
  }

  /* Responsive */

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-visual {
      min-height: 300px;
    }

    .care-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .info-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .cta-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 600px) {
    .hero-grid {
      padding-block: 3.5rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .primary-button,
    .secondary-button {
      width: 100%;
    }

    .care-grid {
      grid-template-columns: 1fr;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>