---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Grupo Médico",
  description = "Atención médica especializada y profesional.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>