---
import { contact } from "../data/contact";

const generalMessage =
  "Hola, me gustaría solicitar información para agendar una cita.";

const whatsappHref =
  `https://wa.me/${contact.primaryWhatsapp.value}?text=${encodeURIComponent(generalMessage)}`;
---
<section class="hero">
  <div class="container hero-container">

    <div class="hero-content">
      <span class="hero-eyebrow">
        Atención médica especializada
      </span>

      <h1>
        Tu salud en manos de <span>especialistas.</span>
      </h1>

      <p class="hero-description">
        Encuentra atención profesional y especializada en un mismo lugar.
        Conoce a nuestros médicos y agenda tu consulta de manera sencilla.
      </p>

      <div class="hero-actions">
        <a
          class="button button-primary"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar por WhatsApp
        </a>

        <a
          class="button button-secondary"
          href="#especialidades"
        >
          Ver especialidades
        </a>
      </div>

      <div class="hero-features">
        <div class="feature">
          <span class="feature-icon">✓</span>
          <span>Atención especializada</span>
        </div>

        <div class="feature">
          <span class="feature-icon">✓</span>
          <span>Trato personalizado</span>
        </div>

        <div class="feature">
          <span class="feature-icon">✓</span>
          <span>Agenda sencilla</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">

      <div class="visual-placeholder">
        <img
          src="/images/promedical_logo.png"
          alt="Pro Medical GDL"
          class="hero-logo"
        />
      </div>

    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;

    background:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 255, 255, 0.92) 38%,
        rgba(245, 249, 251, 0.72) 62%,
        rgba(13, 63, 122, 0.12) 100%
      ),
      url("/images/background.jpeg");

    background-size: cover;
    background-position: 60% center;
    background-repeat: no-repeat;
  }

  .hero-container {
    min-height: 560px;

    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 4rem;

    padding-block: 4rem;
  }

  /* Content */

  .hero-content {
    max-width: 640px;
  }

  .hero-eyebrow {
    display: inline-block;

    margin-bottom: 1rem;

    color: var(--color-secondary);

    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 650px;

    margin: 0;

    color: var(--color-primary);

    font-size: clamp(2.7rem, 5vw, 4.6rem);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  h1 span {
    color: var(--color-secondary);
  }

  .hero-description {
    max-width: 570px;

    margin: 1.5rem 0 0;

    color: var(--color-text-muted);

    font-size: 1.08rem;
    line-height: 1.75;
  }

  /* Buttons */

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;

    margin-top: 2rem;
  }

  .button {
    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding-inline: 1.5rem;

    border: 1px solid transparent;
    border-radius: var(--radius-sm);

    font-size: 0.94rem;
    font-weight: 650;

    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: white;
    background: var(--color-primary);
  }

  .button-primary:hover {
    background: var(--color-primary-dark);
  }

  .button-secondary {
    color: var(--color-primary);

    border-color: var(--color-border);
    background: white;
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
  }

  /* Features */

  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;

    margin-top: 2.5rem;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    color: var(--color-text-muted);

    font-size: 0.84rem;
    font-weight: 500;
  }

  .feature-icon {
    width: 22px;
    height: 22px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: white;
    background: var(--color-secondary);

    font-size: 0.72rem;
    font-weight: 700;
  }

  /* Visual */

  .hero-visual {
    position: relative;
    min-height: 380px;
  }

  .visual-placeholder {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    padding: 1rem 0 1rem 2rem;
  }

  .hero-logo {
    width: min(100%, 560px);
    height: auto;

    display: block;

    object-fit: contain;

    transform: translateX(35px);

    filter: drop-shadow(
      0 10px 24px rgba(8, 45, 89, 0.12)
    );
  }

  /* Tablet */

  @media (max-width: 900px) {
    .hero {
      background-position: 65% center;
    }
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;

      padding-block: 4rem;
    }

    .hero-content {
      max-width: 700px;
    }

    .hero-visual {
      min-height: 420px;
    }

    .visual-placeholder {
      inset: 0;
    }

    .trust-card {
      right: 1rem;
    }
  }

  /* Mobile */

  @media (max-width: 600px) {

    .hero {
      background-position: 70% center;
    }
    
    .hero-container {
      padding-block: 3.5rem;
    }

    h1 {
      font-size: clamp(2.4rem, 12vw, 3.4rem);
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .hero-features {
      flex-direction: column;
      gap: 0.8rem;
    }

    .hero-visual {
      min-height: 350px;
    }

    .trust-card {
      right: 1rem;
      bottom: 1rem;

      width: calc(100% - 2rem);
    }
  }
</style>