---
import type { Specialty } from "../data/specialties";

interface Props {
  specialty: Specialty;
}

const { specialty } = Astro.props;
---

<article class="specialty-card">
  <div class="specialty-icon" aria-hidden="true">
    {specialty.icon}
  </div>

  <div class="specialty-content">
    <h3>{specialty.name}</h3>

    <p>
      {specialty.shortDescription}
    </p>

    <a href={`/especialidades/${specialty.slug}`}>
      Conocer especialidad
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .specialty-card {
    height: 100%;

    display: flex;
    gap: 1.4rem;

    padding: 1.7rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: white;
    box-shadow: var(--shadow-sm);

    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .specialty-card:hover {
    transform: translateY(-4px);

    border-color: rgba(18, 167, 160, 0.35);

    box-shadow: var(--shadow-md);
  }

  .specialty-icon {
    width: 64px;
    height: 64px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: white;
    background:
      linear-gradient(
        145deg,
        var(--color-secondary),
        #087f86
      );

    font-size: 1.8rem;
  }

  .specialty-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h3 {
    margin: 0;

    color: var(--color-primary);

    font-size: 1.08rem;
    line-height: 1.35;
  }

  p {
    flex: 1;

    margin: 0.65rem 0 1.1rem;

    color: var(--color-text-muted);

    font-size: 0.86rem;
    line-height: 1.6;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    color: var(--color-primary);

    font-size: 0.82rem;
    font-weight: 650;

    transition:
      color var(--transition-fast),
      gap var(--transition-fast);
  }

  a:hover {
    gap: 0.7rem;

    color: var(--color-secondary);
  }

  @media (max-width: 480px) {
    .specialty-card {
      flex-direction: column;
    }
  }
</style>