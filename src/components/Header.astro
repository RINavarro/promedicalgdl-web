---
const navigation = [
  { label: "Inicio", href: "/" },
  { label: "Especialidades", href: "/#especialidades" },
  { label: "Médicos", href: "/#medicos" },
  { label: "Nosotros", href: "/#nosotros" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header class="site-header">
  <div class="container header-container">

   <a class="brand" href="/" aria-label="Promedical GDL - Ir al inicio">
      <img
        class="brand-logo"
        src="/images/promedical_logo.png"
        alt="Promedical GDL - Especialidades Médicas"
      />
    </a> 

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <a class="appointment-button" href="#contacto">
      Agendar cita
    </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <nav
    id="mobile-menu"
    class="mobile-nav"
    aria-label="Navegación móvil"
  >
    <div class="container mobile-nav-container">
      {
        navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }

      <a class="mobile-appointment" href="#contacto">
        Agendar cita
      </a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
  const mobileMenu = document.querySelector<HTMLElement>(".mobile-nav");

  menuButton?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("is-open") ?? false;

    menuButton.setAttribute("aria-expanded", String(isOpen));
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("is-open");
      menuButton?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
  }

  .header-container {
    min-height: 82px;

    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;

    margin-right: auto;

    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    width: 110px;
    height: auto;
    object-fit: contain;
  }


  /* Desktop navigation */

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .desktop-nav a {
    position: relative;

    color: var(--color-text);
    font-size: 0.94rem;
    font-weight: 500;

    transition: color var(--transition-fast);
  }

  .desktop-nav a:hover {
    color: var(--color-primary);
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -0.5rem;

    width: 100%;
    height: 2px;

    background: var(--color-secondary);

    transform: scaleX(0);
    transform-origin: right;

    transition: transform var(--transition-fast);
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* CTA */

  .appointment-button {
    min-height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding-inline: 1.4rem;

    border-radius: var(--radius-sm);

    color: white;
    background: var(--color-primary);

    font-size: 0.9rem;
    font-weight: 650;

    transition:
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .appointment-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  /* Mobile */

  .menu-button {
    width: 42px;
    height: 42px;

    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;

    padding: 0;

    border: 0;
    background: transparent;

    cursor: pointer;
  }

  .menu-button span {
    width: 23px;
    height: 2px;

    border-radius: 2px;

    background: var(--color-primary);
  }

  .mobile-nav {
    display: none;

    border-top: 1px solid var(--color-border);
    background: white;
  }

  .mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-container {
    display: flex;
    flex-direction: column;

    padding-block: 1rem 1.5rem;
  }

  .mobile-nav a {
    padding-block: 0.8rem;

    font-weight: 500;
  }

  .mobile-appointment {
    margin-top: 0.5rem;

    text-align: center;

    color: white;
    background: var(--color-primary);

    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .desktop-nav,
    .appointment-button {
      display: none;
    }

    .menu-button {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      min-height: 72px;
    }

    .brand-logo {
      width: 95px;
    }
  }
</style>