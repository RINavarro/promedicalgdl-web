---
import { contact } from "../data/contact";

const generalMessage =
  "Hola, me gustaría solicitar información para agendar una cita.";

const whatsappHref =
  `https://wa.me/${contact.primaryWhatsapp.value}?text=${encodeURIComponent(generalMessage)}`;
  
const navigation = [
  { label: "Inicio", href: "/" },
  { label: "Especialidades", href: "/#especialidades" },
  { label: "Médicos", href: "/#medicos" },
  { label: "Nosotros", href: "/#nosotros" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header class="site-header">
  <div class="container header-container">

   <div class="social-links" aria-label="Redes sociales">
    <span
      class="social-icon social-icon--facebook"
      aria-label="Facebook"
      title="Facebook"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.099 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.49 0-1.956.931-1.956 1.887v2.263h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.099 24 12.073Z"
        />
      </svg>
    </span>

    <span
      class="social-icon social-icon--instagram"
      aria-label="Instagram"
      title="Instagram"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947C23.728 2.695 21.31.273 16.948.073 15.668.014 15.259 0 12 0Zm0 5.838A6.162 6.162 0 1 0 12 18.162 6.162 6.162 0 0 0 12 5.838Zm0 10.162A4 4 0 1 1 12 8a4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"
        />
      </svg>
    </span>
  </div> 

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <a
      class="appointment-button"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      Agendar cita
    </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <nav
    id="mobile-menu"
    class="mobile-nav"
    aria-label="Navegación móvil"
  >
    <div class="container mobile-nav-container">
      {
        navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }

      <a
        class="appointment-button"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Agendar cita
      </a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
  const mobileMenu = document.querySelector<HTMLElement>(".mobile-nav");

  menuButton?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("is-open") ?? false;

    menuButton.setAttribute("aria-expanded", String(isOpen));
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("is-open");
      menuButton?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
  }

  .header-container {
    min-height: 82px;

    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Social networks */

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;

    margin-right: auto;

    flex-shrink: 0;
  }

  .social-icon {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border: 1px solid var(--color-border);
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.9);

    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .social-icon svg {
    width: 18px;
    height: 18px;

    display: block;
  }

  .social-icon--facebook {
    color: var(--color-primary);
  }

  .social-icon--instagram {
    color: var(--color-secondary);
  }

  /* Desktop navigation */

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .desktop-nav a {
    position: relative;

    color: var(--color-text);
    font-size: 0.94rem;
    font-weight: 500;

    transition: color var(--transition-fast);
  }

  .desktop-nav a:hover {
    color: var(--color-primary);
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -0.5rem;

    width: 100%;
    height: 2px;

    background: var(--color-secondary);

    transform: scaleX(0);
    transform-origin: right;

    transition: transform var(--transition-fast);
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* CTA */

  .appointment-button {
    min-height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding-inline: 1.4rem;

    border-radius: var(--radius-sm);

    color: white;
    background: var(--color-primary);

    font-size: 0.9rem;
    font-weight: 650;

    transition:
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .appointment-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  /* Mobile */

  .menu-button {
    width: 42px;
    height: 42px;

    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;

    padding: 0;

    border: 0;
    background: transparent;

    cursor: pointer;
  }

  .menu-button span {
    width: 23px;
    height: 2px;

    border-radius: 2px;

    background: var(--color-primary);
  }

  .mobile-nav {
    display: none;

    border-top: 1px solid var(--color-border);
    background: white;
  }

  .mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-container {
    display: flex;
    flex-direction: column;

    padding-block: 1rem 1.5rem;
  }

  .mobile-nav a {
    padding-block: 0.8rem;

    font-weight: 500;
  }

  .mobile-appointment {
    margin-top: 0.5rem;

    text-align: center;

    color: white;
    background: var(--color-primary);

    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .desktop-nav,
    .appointment-button {
      display: none;
    }

    .menu-button {
      display: flex;
    }
  }

  @media (max-width: 480px) {
  .header-container {
    min-height: 72px;
  }

  .social-icon {
    width: 38px;
    height: 38px;
  }

  .social-icon svg {
    width: 17px;
    height: 17px;
  }
}
</style>